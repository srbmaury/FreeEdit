{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FreeEdit: Backend",
      "type": "debugpy",
      "request": "launch",
      "module": "backend.launch",
      "args": ["--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "FreeEdit: Frontend",
      "type": "chrome",
      "request": "launch",
      "url": "http://127.0.0.1:8000",
      "webRoot": "${workspaceFolder}/frontend"
    }
  ]
}